 "title": "Υψηλές τάσεις · στατιστική διάσπασης: δοκιμή πολλαπλών επιπέδων",
 "description": "Οκτώ επίπεδα τάσης U₁, U₁ + ΔU, … με n κρουστικές το καθένα και k_i διασπάσεις. Η πιθανότητα P_i = k_i/n μετατρέπεται σε z_i = Φ⁻¹(P_i) (χαρτί κανονικής κατανομής) και η ευθεία z = (U − U₅₀)/σ βγαίνει με ελάχιστα τετράγωνα. Επίπεδα με 0 ή n διασπάσεις κόβονται στα 1/(2n) και 1 − 1/(2n). Προεπιλογή: άσκηση 15.5.28 του βιβλίου.",
 "inputs": [
  {
   "name": "U_1",
   "label": "Πρώτο επίπεδο τάσης",
   "unit": "V",
   "value": 102000.0,
   "symbol": "U_1"
  },
  {
   "name": "dU",
   "label": "Βήμα τάσης",
   "unit": "V",
   "value": 1000.0,
   "symbol": "ΔU"
  },
  {
   "name": "n_t",
   "label": "Κρουστικές ανά επίπεδο",
   "unit": "",
   "value": 20,
   "symbol": "n"
  },
  {
   "name": "k_1",
   "label": "Διασπάσεις στο επίπεδο 1",
   "unit": "",
   "value": 1,
   "symbol": "k_1"
  },
  {
   "name": "k_2",
   "label": "Διασπάσεις στο επίπεδο 2",
   "unit": "",
   "value": 2,
   "symbol": "k_2"
  },
  {
   "name": "k_3",
   "label": "Διασπάσεις στο επίπεδο 3",
   "unit": "",
   "value": 4,
   "symbol": "k_3"
  },
  {
   "name": "k_4",
   "label": "Διασπάσεις στο επίπεδο 4",
   "unit": "",
   "value": 8,
   "symbol": "k_4"
  },
  {
   "name": "k_5",
   "label": "Διασπάσεις στο επίπεδο 5",
   "unit": "",
   "value": 10,
   "symbol": "k_5"
  },
  {
   "name": "k_6",
   "label": "Διασπάσεις στο επίπεδο 6",
   "unit": "",
   "value": 14,
   "symbol": "k_6"
  },
  {
   "name": "k_7",
   "label": "Διασπάσεις στο επίπεδο 7",
   "unit": "",
   "value": 16,
   "symbol": "k_7"
  },
  {
   "name": "k_8",
   "label": "Διασπάσεις στο επίπεδο 8",
   "unit": "",
   "value": 18,
   "symbol": "k_8"
  }
 ],
 "steps": [
  {
   "id": "z_1",
   "title": "Επίπεδο 1: z = Φ⁻¹(P)",
   "explain": "P = k_1/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_1/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_1"
  },
  {
   "id": "z_2",
   "title": "Επίπεδο 2: z = Φ⁻¹(P)",
   "explain": "P = k_2/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_2/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_2"
  },
  {
   "id": "z_3",
   "title": "Επίπεδο 3: z = Φ⁻¹(P)",
   "explain": "P = k_3/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_3/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_3"
  },
  {
   "id": "z_4",
   "title": "Επίπεδο 4: z = Φ⁻¹(P)",
   "explain": "P = k_4/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_4/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_4"
  },
  {
   "id": "z_5",
   "title": "Επίπεδο 5: z = Φ⁻¹(P)",
   "explain": "P = k_5/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_5/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_5"
  },
  {
   "id": "z_6",
   "title": "Επίπεδο 6: z = Φ⁻¹(P)",
   "explain": "P = k_6/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_6/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_6"
  },
  {
   "id": "z_7",
   "title": "Επίπεδο 7: z = Φ⁻¹(P)",
   "explain": "P = k_7/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_7/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_7"
  },
  {
   "id": "z_8",
   "title": "Επίπεδο 8: z = Φ⁻¹(P)",
   "explain": "P = k_8/n.",
   "expr": "sqrt(2)*erfinv(2*Min(Max(k_8/n_t, 1/(2*n_t)), 1 - 1/(2*n_t)) - 1)",
   "unit": "",
   "symbol": "z_8"
  },
  {
   "id": "z_m",
   "title": "Μέση τιμή των z",
   "explain": "",
   "expr": "(z_1 + z_2 + z_3 + z_4 + z_5 + z_6 + z_7 + z_8)/8",
   "unit": "",
   "symbol": "z̄"
  },
  {
   "id": "U_m",
   "title": "Μέση τιμή των επιπέδων",
   "explain": "",
   "expr": "U_1 + 3.5*dU",
   "unit": "V",
   "symbol": "Ū"
  },
  {
   "id": "b_s",
   "title": "Κλίση της ευθείας z(U)",
   "explain": "Ελάχιστα τετράγωνα: Σ(U_i − Ū)·z_i / Σ(U_i − Ū)², με Σ(U_i − Ū)² = 42·ΔU².",
   "expr": "(-3.5*z_1 - 2.5*z_2 - 1.5*z_3 - 0.5*z_4 + 0.5*z_5 + 1.5*z_6 + 2.5*z_7 + 3.5*z_8)/(42*dU)",
   "unit": "V⁻¹",
   "symbol": "b"
  },
  {
   "id": "sig",
   "title": "Τυπική απόκλιση",
   "explain": "",
   "expr": "1/b_s",
   "unit": "V",
   "symbol": "σ"
  },
  {
   "id": "U_50",
   "title": "Τάση διάσπασης 50 %",
   "explain": "Εκεί όπου z = 0.",
   "expr": "U_m - z_m/b_s",
   "unit": "V",
   "symbol": "U_50"
  },
  {
   "id": "U_10",
   "title": "Τάση διάσπασης 10 % (στατιστική αντοχή)",
   "explain": "",
   "expr": "U_50 - 1.2816*sig",
   "unit": "V",
   "symbol": "U_10"
  },
  {
   "id": "U_90",
   "title": "Τάση διάσπασης 90 %",
   "explain": "",
   "expr": "U_50 + 1.2816*sig",
   "unit": "V",
   "symbol": "U_90"
  }
 ],
