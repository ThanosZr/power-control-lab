 "title": "Υψηλές τάσεις · κεραυνός: τάση συλλεκτήριου συστήματος και ακτίνα κυλιόμενης σφαίρας",
 "description": "Τάση στην κορυφή του συστήματος αντικεραυνικής προστασίας U = I·R_γ + L′·ℓ·di/dt (άσκηση 15.5.7 του βιβλίου) και ακτίνα κυλιόμενης σφαίρας r = 10·I^0,65 (r σε m, I σε kA, IEC 62305: 20, 30, 45, 60 m για 3, 5, 10, 16 kA).",
 "inputs": [
  {
   "name": "I",
   "label": "Κορυφή του κεραυνικού ρεύματος",
   "unit": "A",
   "value": 60000.0,
   "symbol": "I"
  },
  {
   "name": "dIdt",
   "label": "Κλίση μετώπου",
   "unit": "A/s",
   "value": 35000000000.0,
   "symbol": "di/dt"
  },
  {
   "name": "R_g",
   "label": "Αντίσταση γείωσης",
   "unit": "Ω",
   "value": 5,
   "symbol": "R_γ"
  },
  {
   "name": "L_p",
   "label": "Αυτεπαγωγή αγωγού καθόδου ανά μέτρο",
   "unit": "H/m",
   "value": 1.2e-06,
   "symbol": "L′"
  },
  {
   "name": "l",
   "label": "Μήκος αγωγού καθόδου",
   "unit": "m",
   "value": 7,
   "symbol": "ℓ"
  }
 ],
 "steps": [
  {
   "id": "U_R",
   "title": "Πτώση στη γείωση",
   "explain": "",
   "expr": "I*R_g",
   "unit": "V",
   "symbol": "U_R"
  },
  {
   "id": "U_L",
   "title": "Επαγωγική τάση",
   "explain": "",
   "expr": "L_p*l*dIdt",
   "unit": "V",
   "symbol": "U_L"
  },
  {
   "id": "U_t",
   "title": "Τάση στην κορυφή",
   "explain": "Οι δύο όροι προστίθενται στη χειρότερη περίπτωση (κορυφή ρεύματος και μέγιστη κλίση μαζί).",
   "expr": "U_R + U_L",
   "unit": "V",
   "symbol": "U"
  },
  {
   "id": "r_s",
   "title": "Ακτίνα κυλιόμενης σφαίρας",
   "explain": "IEC 62305: r = 10·I^0,65 με I σε kA.",
   "expr": "10*(I/1000)**0.65",
   "unit": "m",
   "symbol": "r"
  }
 ],
 "sections": [
  {
   "id": "res",
   "title": "Αποτελέσματα",
   "blocks": [
    {
     "type": "kv",
     "rows": [
      [
       "Τάση κορυφής",
       "{U_t|V}"
      ],
      [
       "Ακτίνα σφαίρας",
       "{r_s|m}"
      ]
     ]
    },
    {
     "type": "steps",
     "steps": [
      "U_R",
      "U_L",
      "U_t",
      "r_s"
     ]
    }
   ]
  }
 ]
}
