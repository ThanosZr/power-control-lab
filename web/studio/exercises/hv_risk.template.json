{
 "schema": "pcl-template-1",
 "id": "hv_risk",
 "tutorial": [
  "twave",
  "arrester",
  "marx",
  "chop",
  "hv153",
  "lossline",
  "voltime",
  "lightning"
 ],
 "title": "Υψηλές τάσεις · στατιστικός συντονισμός μόνωσης (κίνδυνος αστοχίας)",
 "description": "Υπερτάσεις με κανονική κατανομή (μέση τιμή μ, τυπική απόκλιση σ) και πιθανότητα διάσπασης της μόνωσης κανονική (U₅₀, σ_μ). Ο κίνδυνος αστοχίας ανά υπέρταση R = ∫ f(U)·P(U) dU γίνεται R = Φ((μ − U₅₀)/√(σ² + σ_μ²)). Στατιστική υπέρταση U₂ (2 %) = μ + 2,054σ, στατιστική αντοχή U₁₀ (10 %) = U₅₀ − 1,282σ_μ και συντελεστής ασφαλείας γ = U₁₀/U₂ (IEC 60071-2).",
 "inputs": [
  {
   "name": "mu",
   "label": "Μέση τιμή υπερτάσεων",
   "unit": "V",
   "value": 700000.0,
   "symbol": "μ"
  },
  {
   "name": "sig",
   "label": "Τυπική απόκλιση υπερτάσεων",
   "unit": "V",
   "value": 70000.0,
   "symbol": "σ"
  },
  {
   "name": "U_50",
   "label": "Τάση διάσπασης 50 % της μόνωσης",
   "unit": "V",
   "value": 1100000.0,
   "symbol": "U_50"
  },
  {
   "name": "sig_s",
   "label": "Τυπική απόκλιση αντοχής",
   "unit": "V",
   "value": 66000.0,
   "symbol": "σ_μ"
  }
 ],
 "steps": [
  {
   "id": "z",
   "title": "Απόσταση σε τυπικές αποκλίσεις",
   "explain": "",
   "expr": "(U_50 - mu)/sqrt(sig**2 + sig_s**2)",
   "unit": "",
   "symbol": "z"
  },
  {
   "id": "Risk",
   "title": "Κίνδυνος αστοχίας ανά υπέρταση",
   "explain": "R = Φ(−z) = ½·erfc(z/√2).",
   "expr": "erfc(z/sqrt(2))/2",
   "unit": "",
   "symbol": "R"
  },
  {
   "id": "U_2",
   "title": "Στατιστική υπέρταση (2 %)",
   "explain": "",
   "expr": "mu + 2.054*sig",
   "unit": "V",
   "symbol": "U_2"
  },
  {
   "id": "U_10",
   "title": "Στατιστική αντοχή (10 %)",
   "explain": "",
   "expr": "U_50 - 1.282*sig_s",
   "unit": "V",
   "symbol": "U_10"
  },
  {
   "id": "gam",
   "title": "Συντελεστής ασφαλείας",
   "explain": "",
   "expr": "U_10/U_2",
   "unit": "",
   "symbol": "γ"
  }
 ],
 "checks": [
  {
   "title": "Κίνδυνος κάτω από 10⁻³",
   "expr": "Risk <= 0.001",
   "pass": "R = {Risk:.3g} ανά υπέρταση.",
   "fail": "R = {Risk:.3g} ανά υπέρταση: μεγάλος."
  }
 ],
 "sections": [
  {
   "id": "res",
   "title": "Κίνδυνος",
   "blocks": [
    {
     "type": "kv",
     "rows": [
      [
       "R",
       "{Risk:.4g}"
      ],
      [
       "U₂, U₁₀",
       "{U_2|V}, {U_10|V}"
      ],
      [
       "γ",
       "{gam:.4g}"
      ]
     ]
    },
    {
     "type": "checks"
    },
    {
     "type": "steps",
     "steps": [
      "z",
      "Risk",
      "U_2",
      "U_10",
      "gam"
     ]
    }
   ]
  }
 ]
}
