{
 "schema": "pcl-template-1",
 "id": "hv_two_layer",
 "tutorial": [
  "twave",
  "arrester",
  "marx",
  "chop",
  "hv153",
  "lossline",
  "voltime",
  "lightning"
 ],
 "title": "Υψηλές τάσεις · διηλεκτρικό δύο στρωμάτων (επίπεδες πλάκες)",
 "description": "Δύο μονωτικά σε σειρά ανάμεσα σε επίπεδες πλάκες (ομογενές πεδίο): η κάθετη μετατόπιση είναι κοινή, ε₁E₁ = ε₂E₂, και U = E₁d₁ + E₂d₂. Το στρώμα με τη μικρή ε παίρνει το μεγάλο πεδίο. Προεπιλογή: η άσκηση 15.5.11 του βιβλίου (αέρας 0,8 cm, γυαλί 0,2 cm, 30 kV).",
 "inputs": [
  {
   "name": "U",
   "label": "Τάση",
   "unit": "V",
   "value": 30000.0,
   "symbol": "U"
  },
  {
   "name": "d_1",
   "label": "Πάχος στρώματος 1 (π.χ. αέρας)",
   "unit": "m",
   "value": 0.008,
   "symbol": "d_1"
  },
  {
   "name": "d_2",
   "label": "Πάχος στρώματος 2 (π.χ. γυαλί)",
   "unit": "m",
   "value": 0.002,
   "symbol": "d_2"
  },
  {
   "name": "eps_1",
   "label": "Σχετική διηλεκτρική σταθερά 1",
   "unit": "",
   "value": 1,
   "symbol": "ε_1"
  },
  {
   "name": "eps_2",
   "label": "Σχετική διηλεκτρική σταθερά 2",
   "unit": "",
   "value": 6.5,
   "symbol": "ε_2"
  },
  {
   "name": "E_b1",
   "label": "Διηλεκτρική αντοχή 1",
   "unit": "V/m",
   "value": 2100000.0,
   "symbol": "E_b1"
  },
  {
   "name": "E_b2",
   "label": "Διηλεκτρική αντοχή 2",
   "unit": "V/m",
   "value": 20000000.0,
   "symbol": "E_b2"
  }
 ],
 "steps": [
  {
   "id": "E_1",
   "title": "Πεδίο στο στρώμα 1",
   "explain": "Από ε₁E₁ = ε₂E₂ και U = E₁d₁ + E₂d₂.",
   "expr": "U*eps_2/(eps_2*d_1 + eps_1*d_2)",
   "unit": "V/m",
   "symbol": "E_1"
  },
  {
   "id": "E_2",
   "title": "Πεδίο στο στρώμα 2",
   "explain": "",
   "expr": "U*eps_1/(eps_2*d_1 + eps_1*d_2)",
   "unit": "V/m",
   "symbol": "E_2"
  },
  {
   "id": "E_1c",
   "title": "Πεδίο 1 σε kV/cm",
   "explain": "",
   "expr": "E_1/1e5",
   "unit": "kV/cm",
   "symbol": "E_1′"
  },
  {
   "id": "E_2c",
   "title": "Πεδίο 2 σε kV/cm",
   "explain": "",
   "expr": "E_2/1e5",
   "unit": "kV/cm",
   "symbol": "E_2′"
  },
  {
   "id": "E_h",
   "title": "Πεδίο αν όλο το διάκενο ήταν ένα υλικό",
   "explain": "Σύγκριση: πόσο ανεβάζει το πεδίο του στρώματος 1 η στρωμάτωση.",
   "expr": "U/(d_1 + d_2)",
   "unit": "V/m",
   "symbol": "E_ομ"
  },
  {
   "id": "U_max",
   "title": "Μέγιστη τάση πριν διασπαστεί κάποιο στρώμα",
   "explain": "",
   "expr": "Min(E_b1*(eps_2*d_1 + eps_1*d_2)/eps_2, E_b2*(eps_2*d_1 + eps_1*d_2)/eps_1)",
   "unit": "V",
   "symbol": "U_max"
  }
 ],
 "checks": [
  {
   "title": "Στρώμα 1",
   "expr": "E_1 <= E_b1",
   "pass": "E₁ = {E_1c:.3g} kV/cm ≤ {E_b1|V/m}.",
   "fail": "E₁ = {E_1c:.3g} kV/cm > αντοχή {E_b1|V/m}: το στρώμα 1 διασπάται (μερικές εκκενώσεις)."
  },
  {
   "title": "Στρώμα 2",
   "expr": "E_2 <= E_b2",
   "pass": "E₂ = {E_2c:.3g} kV/cm ≤ {E_b2|V/m}.",
   "fail": "E₂ = {E_2c:.3g} kV/cm > αντοχή {E_b2|V/m}."
  }
 ],
 "sections": [
  {
   "id": "res",
   "title": "Πεδία και έλεγχος",
   "blocks": [
    {
     "type": "kv",
     "rows": [
      [
       "E₁",
       "{E_1c:.4g} kV/cm"
      ],
      [
       "E₂",
       "{E_2c:.4g} kV/cm"
      ],
      [
       "U_max",
       "{U_max|V}"
      ]
     ]
    },
    {
     "type": "checks"
    },
    {
     "type": "text",
     "text": "Στην άσκηση 15.5.11 το βιβλίο βρίσκει τα ίδια πεδία (36,1 και 5,55 kV/cm) αλλά καταλήγει «η διάταξη επαρκεί». Με αντοχή αέρα 21 kV/cm ο αέρας διασπάται: η διάταξη δεν επαρκεί."
    }
   ]
  },
  {
   "id": "steps",
   "title": "Σχέσεις",
   "blocks": [
    {
     "type": "steps",
     "steps": [
      "E_1",
      "E_2",
      "E_h",
      "U_max"
     ]
    }
   ]
  }
 ]
}
