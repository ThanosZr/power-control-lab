   "expr": "V_bus*N/(N - 5)",
   "unit": "V",
   "when": "N > 5"
  },
  {
   "id": "Vx_5",
   "title": "Βοηθητικό: τάση ακύρωσης (χωρίς όριο)",
   "explain": "",
   "expr": "V_bus*N/Max(N - 5, 1e-9)",
