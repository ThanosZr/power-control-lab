   "title": "Μέσα στο παράθυρο (≥ 0)",
   "explain": "",
   "expr": "Min(Vx_5 - V_min, V_max - Vx_5)",
   "unit": "V"
  },
  {
   "id": "dI_k2",
   "symbol": "Δi_k(f_2)",
   "title": "Κυμάτωση κλάδου στη δεύτερη συχνότητα με το ίδιο L",
   "explain": "",
   "expr": "V_bus*D/(L*f_2)",
