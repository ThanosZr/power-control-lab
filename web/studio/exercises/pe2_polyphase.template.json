{
 "schema": "pcl-template-1",
 "id": "pe2_polyphase",
 "tutorial": "polyphase",
 "primary": true,
 "title": "Άσκηση 2 · πολυφασική σχεδίαση (πρόταση)",
 "description": "Καταμερισμός ισχύος, L ανά κλάδο με το κριτήριο Δi_k ≤ 30 % |I_k| σε όλο το παράθυρο, βήμα φάσης, κυμάτωση κλάδου και αθροίσματος (συμφασικά και μετατοπισμένα), σημεία ακύρωσης και δεύτερη συχνότητα. Οι τιμές έρχονται από το tutorial και το κύκλωμα.",
 "inputs": [
  {
   "name": "V_bus",
   "label": "Τάση ζυγού (χαμηλή πλευρά)",
   "unit": "V",
   "value": 50,
   "from": "meta.vbus"
  },
  {
   "name": "V_st",
   "label": "Τάση αποθήκευσης στο σημείο λειτουργίας",
   "unit": "V",
   "value": 80,
   "from": "meta.vst"
  },
  {
   "name": "V_min",
   "label": "Ελάχιστη V_st",
   "unit": "V",
   "value": 60,
   "from": "meta.vmin"
  },
  {
   "name": "V_max",
   "label": "Μέγιστη V_st",
   "unit": "V",
   "value": 100,
   "from": "meta.vmax"
  },
  {
   "name": "P",
   "label": "Ισχύς",
   "unit": "W",
   "value": 40000,
   "from": "meta.P"
  },
  {
   "name": "N",
   "label": "Πλήθος κλάδων",
   "unit": "",
   "value": 4,
   "from": "meta.N"
  },
  {
   "name": "f_s",
   "label": "Συχνότητα PWM",
   "unit": "Hz",
   "value": 20000,
   "from": "comp.PWM1.fs"
  },
  {
   "name": "L",
   "label": "Αυτεπαγωγή κλάδου στο κύκλωμα",
   "unit": "H",
   "value": 2.0833e-05,
   "from": "comp.L1.L"
  },
  {
   "name": "k_r",
   "label": "Κριτήριο κυμάτωσης (κλάσμα του |I_k|)",
   "unit": "",
   "value": 0.3
  },
  {
   "name": "f_2",
   "label": "Δεύτερη συχνότητα",
   "unit": "Hz",
   "value": 40000
  }
 ],
 "steps": [
  {
   "id": "T",
   "symbol": "T",
   "title": "Περίοδος PWM",
   "explain": "",
   "expr": "1/f_s",
   "unit": "s"
  },
  {
   "id": "I_k",
   "symbol": "I_k",
   "title": "Ρεύμα ανά κλάδο (ισομερής καταμερισμός)",
   "explain": "Όμοιοι κλάδοι, ίδιο duty: κάθε κλάδος παίρνει P/N.",
   "expr": "abs(P)/(N*V_bus)",
   "unit": "A"
  },
  {
   "id": "D_max",
   "symbol": "D_max",
   "title": "Μέγιστο duty του S2 στο παράθυρο",
   "explain": "Στη μέγιστη V_st.",
   "expr": "1 - V_bus/V_max",
   "unit": ""
  },
  {
   "id": "L_min",
   "symbol": "L_min",
   "title": "Ελάχιστη αυτεπαγωγή ανά κλάδο",
   "explain": "Δi_k = V_bus·D/(L·f) μεγαλώνει με το D, άρα το κριτήριο Δi_k ≤ k_r·I_k κρίνεται στη μέγιστη V_st. Για σταθερή συνολική ισχύ το I_k πέφτει με το N, άρα το L_min ανεβαίνει ανάλογα με το N.",
   "expr": "V_bus*D_max/(k_r*I_k*f_s)",
   "unit": "H"
  },
  {
   "id": "I_pk",
   "symbol": "Î_k",
   "title": "Κορυφή ρεύματος κλάδου με L = L_min",
   "explain": "Στη μέγιστη V_st η κυμάτωση είναι ακριβώς k_r·I_k.",
   "expr": "I_k*(1 + k_r/2)",
   "unit": "A"
  },
  {
   "id": "I_pkL",
   "symbol": "Î_k(L)",
   "title": "Κορυφή ρεύματος κλάδου με το L του κυκλώματος",
   "explain": "",
   "expr": "I_k + V_bus*D_max/(2*L*f_s)",
   "unit": "A"
  },
  {
   "id": "dt_ph",
   "symbol": "Δt",
   "title": "Βήμα φάσης στη μετατοπισμένη οδήγηση",
   "explain": "Ο κλάδος k ξεκινά k·T/N μετά τον πρώτο, με κοινό ρολόι.",
   "expr": "T/N",
   "unit": "s"
  },
  {
   "id": "D",
   "symbol": "D",
   "title": "Duty στο σημείο λειτουργίας",
   "explain": "",
   "expr": "1 - V_bus/V_st",
   "unit": ""
  },
  {
   "id": "dI_k",
   "symbol": "Δi_k",
   "title": "Κυμάτωση κλάδου",
   "explain": "",
   "expr": "V_bus*D/(L*f_s)",
   "unit": "A"
  },
  {
   "id": "dI_co",
   "symbol": "Δi_Σ,κοινή",
   "title": "Κυμάτωση αθροίσματος, συμφασικά",
   "explain": "Όλοι οι κλάδοι ανεβαίνουν και κατεβαίνουν μαζί.",
   "expr": "N*dI_k",
   "unit": "A"
  },
  {
   "id": "r",
   "symbol": "r",
   "title": "Κλασματικό μέρος του N·D",
   "explain": "",
   "expr": "N*D - floor(N*D)",
   "unit": ""
  },
  {
   "id": "dI_sh",
   "symbol": "Δi_Σ,μετατ.",
   "title": "Κυμάτωση αθροίσματος, μετατοπισμένα",
   "explain": "Σε κάθε υποπερίοδο T/N άγουν ⌊N·D⌋ ή ⌊N·D⌋ + 1 κάτω διακόπτες· η δεύτερη κατάσταση κρατά r·T/N με κλίση αθροίσματος (1 − r)·V_st/L.",
   "expr": "V_st/L*T/N*r*(1 - r)",
   "unit": "A"
  },
  {
   "id": "f_rip",
   "symbol": "f_Σ",
   "title": "Συχνότητα της κυμάτωσης αθροίσματος (μετατοπισμένα)",
   "explain": "",
   "expr": "N*f_s",
   "unit": "Hz"
  },
  {
   "id": "dI_bound",
   "symbol": "Δi_Σ,max",
   "title": "Άνω όριο της κυμάτωσης αθροίσματος στο παράθυρο (μετατοπισμένα)",
   "explain": "r(1 − r) ≤ 1/4.",
   "expr": "V_max/L*T/N/4",
   "unit": "A"
  },
  {
   "id": "V_c1",
   "symbol": "V_c1",
   "title": "Τάση ακύρωσης για N·D = 1",
   "explain": "",
   "expr": "V_bus*N/(N - 1)",
   "unit": "V",
   "when": "N > 1"
  },
  {
   "id": "Vx_1",
   "title": "Βοηθητικό: τάση ακύρωσης (χωρίς όριο)",
   "explain": "",
   "expr": "V_bus*N/Max(N - 1, 1e-9)",
   "unit": "V"
  },
  {
   "id": "in_1",
   "symbol": "w_1",
   "title": "Μέσα στο παράθυρο (≥ 0)",
   "explain": "",
   "expr": "Min(Vx_1 - V_min, V_max - Vx_1)",
   "unit": "V"
  },
  {
   "id": "V_c2",
   "symbol": "V_c2",
   "title": "Τάση ακύρωσης για N·D = 2",
   "explain": "",
   "expr": "V_bus*N/(N - 2)",
   "unit": "V",
   "when": "N > 2"
  },
  {
   "id": "Vx_2",
   "title": "Βοηθητικό: τάση ακύρωσης (χωρίς όριο)",
   "explain": "",
   "expr": "V_bus*N/Max(N - 2, 1e-9)",
   "unit": "V"
  },
  {
   "id": "in_2",
   "symbol": "w_2",
   "title": "Μέσα στο παράθυρο (≥ 0)",
   "explain": "",
   "expr": "Min(Vx_2 - V_min, V_max - Vx_2)",
   "unit": "V"
  },
  {
   "id": "V_c3",
   "symbol": "V_c3",
   "title": "Τάση ακύρωσης για N·D = 3",
   "explain": "",
   "expr": "V_bus*N/(N - 3)",
   "unit": "V",
   "when": "N > 3"
  },
  {
   "id": "Vx_3",
   "title": "Βοηθητικό: τάση ακύρωσης (χωρίς όριο)",
   "explain": "",
   "expr": "V_bus*N/Max(N - 3, 1e-9)",
   "unit": "V"
  },
  {
   "id": "in_3",
   "symbol": "w_3",
   "title": "Μέσα στο παράθυρο (≥ 0)",
   "explain": "",
   "expr": "Min(Vx_3 - V_min, V_max - Vx_3)",
   "unit": "V"
  },
  {
   "id": "V_c4",
   "symbol": "V_c4",
   "title": "Τάση ακύρωσης για N·D = 4",
   "explain": "",
   "expr": "V_bus*N/(N - 4)",
   "unit": "V",
   "when": "N > 4"
  },
  {
   "id": "Vx_4",
   "title": "Βοηθητικό: τάση ακύρωσης (χωρίς όριο)",
   "explain": "",
   "expr": "V_bus*N/Max(N - 4, 1e-9)",
   "unit": "V"
  },
  {
   "id": "in_4",
   "symbol": "w_4",
   "title": "Μέσα στο παράθυρο (≥ 0)",
   "explain": "",
   "expr": "Min(Vx_4 - V_min, V_max - Vx_4)",
   "unit": "V"
  },
  {
   "id": "V_c5",
   "symbol": "V_c5",
   "title": "Τάση ακύρωσης για N·D = 5",
   "explain": "",
   "expr": "V_bus*N/(N - 5)",
   "unit": "V",
   "when": "N > 5"
  },
  {
   "id": "Vx_5",
   "title": "Βοηθητικό: τάση ακύρωσης (χωρίς όριο)",
   "explain": "",
   "expr": "V_bus*N/Max(N - 5, 1e-9)",
   "unit": "V"
  },
  {
   "id": "in_5",
   "symbol": "w_5",
   "title": "Μέσα στο παράθυρο (≥ 0)",
   "explain": "",
   "expr": "Min(Vx_5 - V_min, V_max - Vx_5)",
   "unit": "V"
  },
  {
   "id": "dI_k2",
   "symbol": "Δi_k(f_2)",
   "title": "Κυμάτωση κλάδου στη δεύτερη συχνότητα με το ίδιο L",
   "explain": "",
   "expr": "V_bus*D/(L*f_2)",
   "unit": "A"
  },
  {
   "id": "L_min2",
   "symbol": "L_min(f_2)",
   "title": "L_min στη δεύτερη συχνότητα",
   "explain": "Για την ίδια ιδανική κυμάτωση το L·f μένει σταθερό.",
   "expr": "L_min*f_s/f_2",
   "unit": "H"
  }
 ],
 "checks": [
  {
   "title": "Κριτήριο 30 % σε όλο το παράθυρο με το L του κυκλώματος",
   "expr": "V_bus*D_max/(L*f_s) <= k_r*I_k*(1 + 1e-4)",
   "pass": "Στη μέγιστη V_st: Δi_k = {V_bus*D_max/(L*f_s)|A} ≤ {k_r*I_k|A}.",
   "fail": "Στη μέγιστη V_st: Δi_k = {V_bus*D_max/(L*f_s)|A} > {k_r*I_k|A}: χρειάζεται L ≥ {L_min|H}."
  }
 ],
 "tables": {
  "vst": {
   "title": "Κυμάτωση στο παράθυρο με το L του κυκλώματος",
   "label_head": "V_st",
   "vary": [
    {
     "label": "60 V",
     "V_st": 60
    },
    {
     "label": "66,67 V",
     "V_st": 66.66666666666667
    },
    {
     "label": "75 V",
     "V_st": 75
    },
    {
     "label": "80 V",
     "V_st": 80
    },
    {
     "label": "100 V",
     "V_st": 100
    }
   ],
   "columns": [
    [
     "D",
     "",
     "D"
    ],
    [
     "r",
     "",
     "r"
    ],
    [
     "dI_k",
     "A",
     "Δi_k"
    ],
    [
     "dI_sh",
     "A",
     "Δi_Σ μετατοπισμένα"
    ],
    [
     "dI_co",
     "A",
     "Δi_Σ συμφασικά"
    ]
   ]
  },
  "nphase": {
   "title": "Επιλογή N για την ίδια ισχύ και συχνότητα",
   "label_head": "N",
   "vary": [
    {
     "label": "2",
     "N": 2
    },
    {
     "label": "3",
     "N": 3
    },
    {
     "label": "4",
     "N": 4
    },
    {
     "label": "5",
     "N": 5
    },
    {
     "label": "6",
     "N": 6
    }
   ],
   "columns": [
    [
     "I_k",
     "A",
     "I_k"
    ],
    [
     "L_min",
     "H",
     "L_min"
    ],
    [
     "I_pk",
     "A",
     "Î_k"
    ],
    [
     "dt_ph",
     "s",
     "Δt φάσης"
    ]
   ]
  }
 },
 "sections": [
  {
   "id": "share",
   "title": "Καταμερισμός και L ανά κλάδο",
   "blocks": [
    {
     "type": "kv",
     "rows": [
      [
       "N",
       "{N:.0f}"
      ],
      [
       "I_k",
       "{I_k|A}"
      ],
      [
       "L_min",
       "{L_min|H}"
      ],
      [
       "Κορυφή κλάδου",
       "{I_pk|A}"
      ]
     ]
    },
    {
     "type": "text",
     "text": "Το N επιλέγεται από το μέγιστο ρεύμα κλάδου και τα όρια των διαθέσιμων ημιαγωγών: με {N:.0f} κλάδους η κορυφή είναι {I_pk|A} ανά κλάδο. Ο πίνακας «Επιλογή N» δίνει τη σύγκριση για 2–6 κλάδους."
    },
    {
     "type": "steps",
     "steps": [
      "T",
      "I_k",
      "D_max",
      "L_min",
      "I_pk",
      "I_pkL"
     ]
    },
    {
     "type": "checks"
    }
   ]
  },
  {
   "id": "clock",
   "title": "Κοινό ρολόι και φάσεις",
   "blocks": [
    {
     "type": "text",
     "text": "Συμφασική οδήγηση: όλα τα φέροντα στην ίδια φάση. Μετατοπισμένη: ο κλάδος k καθυστερεί k·T/N, δηλαδή 0, {dt_ph|s}, {2*dt_ph|s}, {3*dt_ph|s}, … με κοινό ρολόι. Κάθε κλάδος ξεκινά από την περιοδική του κυματομορφή στη δική του φάση, με κοινό μέσο ρεύμα."
    },
    {
     "type": "steps",
     "steps": [
      "dt_ph"
     ]
    }
   ]
  },
  {
   "id": "ripple",
   "title": "Κυμάτωση κλάδου και αθροίσματος",
   "blocks": [
    {
     "type": "kv",
     "rows": [
      [
       "V_st",
       "{V_st|V}"
      ],
      [
       "Δi_k",
       "{dI_k|A}"
      ],
      [
       "Δi_Σ συμφασικά",
       "{dI_co|A}"
      ],
      [
       "Δi_Σ μετατοπισμένα",
       "{dI_sh|A}"
      ],
      [
       "Συχνότητα αθροίσματος",
       "{f_rip|Hz}"
      ]
     ]
    },
    {
     "type": "steps",
     "steps": [
      "D",
      "dI_k",
      "dI_co",
      "r",
      "dI_sh",
      "f_rip",
      "dI_bound"
     ]
    }
   ]
  },
  {
   "id": "cancel",
   "title": "Σημεία ακύρωσης στο παράθυρο",
   "blocks": [
    {
     "type": "text",
     "text": "Με μετατοπισμένη οδήγηση η κυμάτωση του αθροίσματος μηδενίζεται όταν το N·D είναι ακέραιος, δηλαδή στις τάσεις V_st = V_bus/(1 − m/N)."
    },
    {
     "type": "kv",
     "when": "in_1 >= 0",
     "rows": [
      [
       "N·D = 1",
       "{V_c1|V}"
      ]
     ]
    },
    {
     "type": "kv",
     "when": "in_2 >= 0",
     "rows": [
      [
       "N·D = 2",
       "{V_c2|V}"
      ]
     ]
    },
    {
     "type": "kv",
     "when": "in_3 >= 0",
     "rows": [
      [
       "N·D = 3",
       "{V_c3|V}"
      ]
     ]
    },
    {
     "type": "kv",
     "when": "in_4 >= 0",
     "rows": [
      [
       "N·D = 4",
       "{V_c4|V}"
      ]
     ]
    },
    {
     "type": "kv",
     "when": "in_5 >= 0",
     "rows": [
      [
       "N·D = 5",
       "{V_c5|V}"
      ]
     ]
    },
    {
     "type": "steps",
     "when": "in_1 >= 0",
     "steps": [
      "V_c1"
     ]
    },
    {
     "type": "steps",
     "when": "in_2 >= 0",
     "steps": [
      "V_c2"
     ]
    },
    {
     "type": "steps",
     "when": "in_3 >= 0",
     "steps": [
      "V_c3"
     ]
    },
    {
     "type": "steps",
     "when": "in_4 >= 0",
     "steps": [
      "V_c4"
     ]
    },
    {
     "type": "steps",
     "when": "in_5 >= 0",
     "steps": [
      "V_c5"
     ]
    }
   ]
  },
  {
   "id": "freq",
   "title": "Δεύτερη συχνότητα",
   "blocks": [
    {
     "type": "text",
     "text": "Πρώτα με ίδια N, L και σημείο λειτουργίας: η κυμάτωση κλάδου πέφτει από {dI_k|A} σε {dI_k2|A}. Μετά, για την ίδια κυμάτωση, το L μπορεί να γίνει {L_min2|H}."
    },
    {
     "type": "steps",
     "steps": [
      "dI_k2",
      "L_min2"
     ]
    }
   ]
  },
  {
   "id": "tables",
   "title": "Πίνακες",
   "blocks": [
    {
     "type": "table",
     "table": "vst"
    },
    {
     "type": "table",
     "table": "nphase"
    }
   ]
  }
 ]
}