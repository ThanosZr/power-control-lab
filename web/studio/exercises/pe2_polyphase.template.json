 "questions": [
  {
   "id": "ik",
   "kind": "number",
   "unit": "A",
   "text": "Ρεύμα ανά κλάδο |I_k| για P = {P|W} σε {N:.0f} κλάδους, με ζυγό {V_bus|V};",
   "answer": "I_k",
   "tol": 0.005,
   "mistakes": [
    {
     "expr": "abs(P)/V_bus",
     "text": "Αυτό είναι το συνολικό ρεύμα. Με ισομερή καταμερισμό μοιράζεται σε N κλάδους."
    },
    {
     "expr": "abs(P)/(N*V_st)",
     "text": "Το πηνίο είναι στη χαμηλή πλευρά: το ρεύμα του είναι P/(N·V_bus), όχι P/(N·V_st)."
    }
   ],
   "steps": [
    "I_k"
   ],
   "sim": {
    "key": "I:L1",
    "stat": "avg",
    "abs": true
   },
   "hint": "Ισχύς ανά κλάδο P/N, στην τάση του ζυγού."
  },
  {
   "id": "lmin",
   "kind": "number",
   "unit": "H",
   "text": "Ελάχιστο L ανά κλάδο ώστε Δi_k ≤ {100*k_r:.0f} % |I_k| σε όλο το παράθυρο V_st = {V_min|V}…{V_max|V};",
   "answer": "L_min",
   "tol": 0.01,
   "mistakes": [
