{
 "schema": "pcl-template-1",
 "id": "hv_impulse_design",
 "tutorial": [
  "hv153",
  "marx",
  "chop"
 ],
 "primary": true,
 "title": "Υψηλές τάσεις · σχεδίαση γεννήτριας κρουστικών (κύκλωμα β)",
 "description": "Οι αντιστάσεις μετώπου και ουράς μιας μονοβάθμιας (ή ισοδύναμης πολυβάθμιας) γεννήτριας κύκλωμα β, με τους προσεγγιστικούς τύπους του βιβλίου «Υψηλές Τάσεις» (συντελεστές k₁ = 0,73, k₂ = 2,96 για 1,2/50 μs) και ακριβώς από τις ρίζες α₁, α₂ της κυματομορφής (σχέσεις 3.21–3.32). Οι είσοδοι έρχονται από το tutorial: C_κ = C₁ (σε σειρά), C_φ = όλο το φορτίο, U = τάση φόρτισης.",
 "inputs": [
  {
   "name": "C_k",
   "label": "Πυκνωτής κρούσης (ισοδύναμος σε σειρά)",
   "unit": "F",
   "value": 2.5e-08,
   "symbol": "C_κ",
   "from": "meta.C1"
  },
  {
   "name": "C_f",
   "label": "Φορτίο (όλο: C_φ, καταμεριστής, δοκίμιο)",
   "unit": "F",
   "value": 7e-10,
   "symbol": "C_φ",
   "from": "meta.C2"
  },
  {
   "name": "U_DC",
   "label": "Τάση φόρτισης",
   "unit": "V",
   "value": 300000.0,
   "symbol": "U",
   "from": "meta.U"
  },
  {
   "name": "T_1",
   "label": "Χρόνος μετώπου (στόχος)",
   "unit": "s",
   "value": 1.2e-06,
   "symbol": "T_1"
  },
  {
   "name": "T_2",
   "label": "Χρόνος ημίσεως εύρους (στόχος)",
   "unit": "s",
   "value": 5e-05,
   "symbol": "T_2"
  },
  {
   "name": "k_1",
   "label": "Συντελεστής ουράς του βιβλίου (1/α)",
   "unit": "",
   "value": 0.73,
   "symbol": "k_1"
  },
  {
   "name": "k_2",
   "label": "Συντελεστής μετώπου του βιβλίου (2/β)",
   "unit": "",
   "value": 2.96,
   "symbol": "k_2"
  },
  {
   "name": "alpha_1",
   "label": "Ρίζα α₁ της κυματομορφής (1,2/50: 1/68,2 μs)",
   "unit": "s⁻¹",
   "value": 14659.1,
   "symbol": "α_1"
  },
  {
   "name": "alpha_2",
   "label": "Ρίζα α₂ της κυματομορφής (1,2/50: 1/0,405 μs)",
   "unit": "s⁻¹",
   "value": 2468927.0,
   "symbol": "α_2"
  }
 ],
 "steps": [
  {
   "id": "eta_b",
   "title": "Βαθμός απόδοσης (προσέγγιση του βιβλίου)",
   "explain": "Μόνο η χωρητική διαίρεση: αγνοεί την εκφόρτιση του C_κ από την R_ε όσο φορτίζεται το C_φ.",
   "expr": "C_k/(C_k + C_f)",
   "unit": "",
   "symbol": "η_β"
  },
  {
   "id": "R_mb",
   "title": "Αντίσταση μετώπου (τύπος του βιβλίου)",
   "explain": "T1 ≈ k₂·R_μ·C_κC_φ/(C_κ + C_φ).",
   "expr": "T_1/(k_2*C_k*C_f/(C_k + C_f))",
   "unit": "Ω",
   "symbol": "R_μβ"
  },
  {
   "id": "R_eb",
   "title": "Αντίσταση ουράς (τύπος του βιβλίου)",
   "explain": "T2 ≈ k₁·R_ε·(C_κ + C_φ).",
   "expr": "T_2/(k_1*(C_k + C_f))",
   "unit": "Ω",
   "symbol": "R_εβ"
  },
  {
   "id": "a_s",
   "title": "Άθροισμα των ριζών",
   "explain": "Από s² + a·s + b = 0: a = 1/(R_μC_κ) + 1/(R_μC_φ) + 1/(R_εC_κ).",
   "expr": "alpha_1 + alpha_2",
   "unit": "s⁻¹",
   "symbol": "a"
  },
  {
   "id": "b_p",
   "title": "Γινόμενο των ριζών",
   "explain": "b = 1/(R_μR_εC_κC_φ).",
   "expr": "alpha_1*alpha_2",
   "unit": "s⁻²",
   "symbol": "b"
  },
  {
   "id": "S_c",
   "title": "Βοηθητικό",
   "explain": "",
   "expr": "1/C_k + 1/C_f",
   "unit": "F⁻¹",
   "symbol": "S"
  },
  {
   "id": "Disc",
   "title": "Διακρίνουσα της σχεδίασης",
   "explain": "Με x = 1/R_μ: S·x² − a·x + b·C_φ = 0. Χωρίς πραγματική ρίζα δεν υπάρχει γεννήτριας κύκλωμα β με αυτά τα C για αυτή την κυματομορφή.",
   "expr": "a_s**2 - 4*S_c*b_p*C_f",
   "unit": "",
   "symbol": "Δ"
  },
  {
   "id": "x_m",
   "title": "Αγωγιμότητα μετώπου",
   "explain": "Η μεγαλύτερη ρίζα: μικρή R_μ, μεγάλη R_ε.",
   "expr": "(a_s + sqrt(Disc))/(2*S_c)",
   "unit": "S",
   "symbol": "x",
   "when": "Disc >= 0"
  },
  {
   "id": "R_m",
   "title": "Αντίσταση μετώπου (ακριβής)",
   "explain": "",
   "expr": "1/x_m",
   "unit": "Ω",
   "symbol": "R_μ",
   "when": "Disc >= 0"
  },
  {
   "id": "R_e",
   "title": "Αντίσταση ουράς (ακριβής)",
   "explain": "R_ε = 1/(b·R_μ·C_κ·C_φ).",
   "expr": "x_m/(b_p*C_k*C_f)",
   "unit": "Ω",
   "symbol": "R_ε",
   "when": "Disc >= 0"
  },
  {
   "id": "t_1",
   "title": "Χρόνος κορυφής",
   "explain": "(3.31)",
   "expr": "log(alpha_2/alpha_1)/(alpha_2 - alpha_1)",
   "unit": "s",
   "symbol": "t_1"
  },
  {
   "id": "eta",
   "title": "Βαθμός απόδοσης (ακριβής)",
   "explain": "(3.32): η = V_p/U.",
   "expr": "(exp(-alpha_1*t_1) - exp(-alpha_2*t_1))/(R_m*C_f*(alpha_2 - alpha_1))",
   "unit": "",
   "symbol": "η",
   "when": "Disc >= 0"
  },
  {
   "id": "U_p",
   "title": "Κορυφή (ακριβής)",
   "explain": "",
   "expr": "eta*U_DC",
   "unit": "V",
   "symbol": "U_p",
   "when": "Disc >= 0"
  },
  {
   "id": "U_pb",
   "title": "Κορυφή (βιβλίο)",
   "explain": "",
   "expr": "eta_b*U_DC",
   "unit": "V",
   "symbol": "U_pβ"
  },
  {
   "id": "W",
   "title": "Ενέργεια της γεννήτριας",
   "explain": "W = ½·C_κ·U².",
   "expr": "C_k*U_DC**2/2",
   "unit": "J",
   "symbol": "W"
  }
 ],
 "checks": [
  {
   "title": "Υπάρχει σχεδίαση κύκλωμα β",
   "expr": "Disc >= 0",
   "pass": "R_μ = {R_m|Ω}, R_ε = {R_e|Ω} (βιβλίο {R_mb|Ω}, {R_eb|Ω}).",
   "fail": "Δεν υπάρχουν R_μ, R_ε για αυτά τα C_κ, C_φ: μεγάλωσε το C_κ/C_φ."
  },
  {
   "title": "Η προσέγγιση του βιβλίου υπερεκτιμά την κορυφή",
   "when": "Disc >= 0",
   "expr": "eta_b >= eta",
   "pass": "η = {eta:.4g} < η_β = {eta_b:.4g}: η κορυφή είναι {U_p|V}, όχι {U_pb|V}.",
   "fail": "η = {eta:.4g} ≥ η_β = {eta_b:.4g}."
  }
 ],
 "sections": [
  {
   "id": "design",
   "title": "Σχεδίαση",
   "blocks": [
    {
     "type": "kv",
     "rows": [
      [
       "R_μ (ακριβής)",
       "{R_m|Ω}"
      ],
      [
       "R_ε (ακριβής)",
       "{R_e|Ω}"
      ],
      [
       "R_μ, R_ε (βιβλίο)",
       "{R_mb|Ω}, {R_eb|Ω}"
      ],
      [
       "Κορυφή",
       "{U_p|V} (βιβλίο {U_pb|V})"
      ],
      [
       "Ενέργεια",
       "{W|J}"
      ]
     ]
    },
    {
     "type": "checks"
    }
   ]
  },
  {
   "id": "book",
   "title": "Τύποι του βιβλίου",
   "blocks": [
    {
     "type": "steps",
     "steps": [
      "eta_b",
      "R_mb",
      "R_eb",
      "U_pb"
     ]
    }
   ]
  },
  {
   "id": "exact",
   "title": "Ακριβής λύση από τις ρίζες α₁, α₂",
   "blocks": [
    {
     "type": "steps",
     "steps": [
      "a_s",
      "b_p",
      "S_c",
      "Disc",
      "x_m",
      "R_m",
      "R_e",
      "t_1",
      "eta",
      "U_p",
      "W"
     ]
    }
   ]
  }
 ]
}
